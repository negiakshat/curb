<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- Curb logo on the left with terracotta tint -->
    <ImageView
        android:id="@+id/notification_custom_icon_expanded"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_curb_notification"
        android:tint="#8F4C38"
        android:scaleType="fitCenter"
        android:layout_gravity="top" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="14dp">

        <TextView
            android:id="@+id/notification_title_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"
            android:textStyle="bold"
            android:textSize="18sp"
            android:ellipsize="end"
            android:singleLine="true" />

        <TextView
            android:id="@+id/notification_body_expanded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Line2"
            android:textSize="15sp" />

    </LinearLayout>

</LinearLayout>
